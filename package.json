{
  "name": "emmanuel-blog",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview",
    "preview:cloudflare": "wrangler pages dev dist",
    "deploy:canary": "astro check && astro build && wrangler pages deploy dist --branch=canary",
    "deploy:production": "astro check && astro build && wrangler pages deploy dist --branch=main",
    "test": "node --test tests/*.test.mjs",
    "astro": "astro",
    "wrangler": "wrangler"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "astro": "7.3.5",
    "mdast-util-to-string": "4.0.0",
    "reading-time": "1.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3",
    "wrangler": "4.141.0"
  }
}