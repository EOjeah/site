---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostMeta from '../components/PostMeta.astro';
import { site } from '../site';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const entries = await Promise.all(posts.map(async (post) => ({
  post,
  readingTime: (await render(post)).remarkPluginFrontmatter.minutesRead as string,
})));
---

<BaseLayout>
  <main id="main">
    <section class="introduction">
      <p class="eyebrow">{site.notebookLabel}</p>
      <h1>Hi, I’m {site.name}<span>.</span></h1>
      <p class="introduction-text">{site.introduction}</p>
      <p class="introduction-note">{site.introductionNote}</p>
    </section>
    <section id="writing" aria-labelledby="writing-heading">
      <div class="section-heading">
        <h2 id="writing-heading" class="section-title">Writing</h2>
        <span>{site.writingNote}</span>
      </div>
      {entries.length === 0 ? (
        <p class="empty-state">Nothing published yet.</p>
      ) : (
        <ul class="post-list">
          {entries.map(({ post, readingTime }) => (
            <li>
              <article class:list={['post-summary', { 'has-cover': post.data.cover }]}>
                <div class="post-summary-text">
                  <PostMeta date={post.data.publishedAt} readingTime={readingTime} />
                  <h2><a href={`/writing/${post.id}/`}>{post.data.title}</a></h2>
                  <p class="post-description">{post.data.description}</p>
                  <a class="read-link" href={`/writing/${post.id}/`}>Read the post <span aria-hidden="true">↗</span></a>
                </div>
                {post.data.cover && (
                  <a class="post-cover" href={`/writing/${post.id}/`} aria-label={`Read ${post.data.title}`}>
                    <Image src={post.data.cover.image} alt={post.data.cover.alt} loading="lazy" />
                  </a>
                )}
              </article>
            </li>
          ))}
        </ul>
      )}
    </section>
  </main>
</BaseLayout>
